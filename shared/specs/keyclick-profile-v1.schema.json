{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fallax-Vision/keyclick/shared/specs/keyclick-profile-v1.schema.json",
  "title": "KeyClick profile manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "createdUtc", "applicationVersion", "sections", "passwordProtected", "fileHashes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "createdUtc": { "type": "string", "format": "date-time" },
    "applicationVersion": { "type": "string", "maxLength": 64 },
    "sections": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["settings-mappings", "custom-packs-audio", "statistics", "wellness-achievements"] }
    },
    "passwordProtected": { "type": "boolean" },
    "fileHashes": {
      "type": "object",
      "propertyNames": { "pattern": "^(settings|statistics)\\.json$|^media/(packs|sounds)/[^/]+$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  }
}
