{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fallax-Vision/keyclick/shared/specs/sound-pack.schema.json",
  "title": "KeyClick Sound Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "groups"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "family": { "type": "string", "maxLength": 80 },
    "description": { "type": "string", "maxLength": 240 },
    "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "groups": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "enum": [
          "letters", "numbers", "punctuation", "modifiers", "navigation", "functionAndMedia",
          "numpad", "locks", "space", "enter", "editing", "pointerPrimary", "pointerSecondary",
          "pointerAuxiliary", "wheel", "outcomes"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "enum": ["base", "shift", "altGr", "enabled", "disabled"] },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 160 }
        }
      }
    }
  }
}
