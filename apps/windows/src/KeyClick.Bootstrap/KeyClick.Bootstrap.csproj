<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\keyclick.ico</ApplicationIcon>
    <AssemblyName>KeyClick</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(PayloadPath)' != '' and Exists('$(PayloadPath)')">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="KeyClick.payload.zip" />
  </ItemGroup>

</Project>
