<Window x:Class="KeyClick.App.FunStatDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FunComparisons}" Width="660" Height="650" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{Binding Value}" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0" />
      <TextBlock Text="{DynamicResource FunComparisonsHelp}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Facts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="16,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding Detail}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="7" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="{DynamicResource FunSourcePrefix}" Style="{StaticResource MutedText}" />
                  <TextBlock Text=": " Style="{StaticResource MutedText}" />
                  <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Button Grid.Row="2" Content="{DynamicResource Close}" IsCancel="True" HorizontalAlignment="Right" Style="{StaticResource DialogButton}" Margin="0,16,0,0" />
  </Grid>
</Window>
