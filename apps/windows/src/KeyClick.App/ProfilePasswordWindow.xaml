<Window x:Class="KeyClick.App.ProfilePasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProfilePassword}" Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="pack://application:,,,/Assets/keyclick.ico">
  <StackPanel Margin="24"><TextBlock Text="{DynamicResource ProfilePassword}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource ProfilePasswordHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" /><PasswordBox x:Name="PasswordField" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="{DynamicResource Cancel}" IsCancel="True" Margin="0,0,10,0" Style="{StaticResource DialogButton}" /><Button Content="{DynamicResource Continue}" IsDefault="True" Click="Continue_Click" Style="{StaticResource DialogAccentButton}" /></StackPanel></StackPanel>
</Window>
