<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KeyClick.Core\KeyClick.Core.csproj" />
    <ProjectReference Include="..\KeyClick.Infrastructure.Windows\KeyClick.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\KeyClick.Updater\KeyClick.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\keyclick.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\keyclick.ico" Link="Assets\keyclick.ico" />
    <Resource Include="..\..\assets\keyclick-icon.png" Link="Assets\keyclick-icon.png" />
  </ItemGroup>

</Project>
