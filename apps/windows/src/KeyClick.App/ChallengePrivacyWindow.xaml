<Window x:Class="KeyClick.App.ChallengePrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ChallengePrivacyTitle}" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/keyclick.ico">
  <StackPanel Margin="26">
    <TextBlock Text="{DynamicResource ChallengePrivacyTitle}" Style="{StaticResource PageTitle}" />
    <Border Style="{StaticResource Card}" Margin="0,4,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="25"
                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,12,0" />
        <TextBlock Grid.Column="1" Text="{DynamicResource ChallengePrivacyDisclosure}"
                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21" />
      </Grid>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{DynamicResource Cancel}" Click="Cancel_Click" Margin="0,0,10,0" Style="{StaticResource DialogButton}" />
      <Button Content="{DynamicResource ConfirmAndContinue}" Click="Continue_Click" Style="{StaticResource DialogAccentButton}" />
    </StackPanel>
  </StackPanel>
</Window>
