<Window x:Class="KeyClick.App.ProfileImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ImportProfile}" Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="pack://application:,,,/Assets/keyclick.ico">
  <StackPanel Margin="24"><TextBlock Text="{DynamicResource ProfileImportPreview}" Style="{StaticResource PageTitle}" /><TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,5,0,14" /><TextBlock Text="{DynamicResource ProfileMergeHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" /><CheckBox x:Name="UseImported" Content="{DynamicResource UseImportedMediaConflicts}" Margin="0,12,0,0" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="{DynamicResource Cancel}" IsCancel="True" Margin="0,0,8,0" /><Button Content="{DynamicResource Import}" Click="Import_Click" Style="{StaticResource AccentButton}" /></StackPanel></StackPanel>
</Window>
