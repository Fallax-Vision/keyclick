                          <TextBlock Text="{Binding Family}" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
                          <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                  Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
