<Window x:Class="KeyClick.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyClick.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding AppTitle}" Width="1160" Height="780" MinWidth="940" MinHeight="650"
        Icon="pack://application:,,,/Assets/keyclick.ico"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged" SourceInitialized="Window_SourceInitialized" Deactivated="Window_Deactivated">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="18" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
          <Image Width="34" Height="34" Source="pack://application:,,,/Assets/keyclick-icon.png"
                 Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="Fant" />
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding AppTitle}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" MaxWidth="135" />
            <TextBlock Text="{DynamicResource AppTagline}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,10" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="{Binding SoundStateText}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActivePackName}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="0" Checked="Navigation_Checked" IsChecked="True" AutomationProperties.Name="{DynamicResource NavHome}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavHome}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="2" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavSoundPacks}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavSoundPacks}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="3" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavMappings}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE92E;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavMappings}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="4" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavPointerStudio}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE962;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavPointerStudio}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="5" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavShortcuts}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavShortcuts}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="9" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavTypingChallenge}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C1;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavTypingChallenge}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="1" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavStatistics}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavStatistics}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="6" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavSettings}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavSettings}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="7" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavIntegrations}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavIntegrations}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="8" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavAbout}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavAbout}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="3">
          <Button Content="{DynamicResource ToggleAllSounds}" Command="{Binding ToggleSoundsCommand}" />
          <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" Margin="2,10,2,0"
                     HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="PageTabs" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="PageTabs_SelectionChanged">
      <TabControl.Resources>
        <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
      </TabControl.Resources>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{DynamicResource NavHome}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource HomeIntro}" Style="{StaticResource PageIntro}" />

            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding SoundStateText}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SoundStateDescription}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource ToggleSounds}" Command="{Binding ToggleSoundsCommand}"
                        Style="{StaticResource AccentButton}" MinWidth="140" Margin="24,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" DataContext="{Binding Statistics}">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource KeyboardHeatmap}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                    <Button Content="?" Style="{StaticResource HelpIconButton}" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource KeyboardHeatmapInformation}">
                      <Button.ToolTip>
                        <ToolTip><TextBlock Text="{DynamicResource KeyboardHeatmapHelp}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                      </Button.ToolTip>
                    </Button>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource HeatmapDuration}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox ItemsSource="{Binding HeatmapPeriodOptions}" SelectedIndex="{Binding HeatmapPeriodIndex}" Width="150" AutomationProperties.Name="{DynamicResource HeatmapDuration}" />
                    </StackPanel>
                    <ToggleButton Content="{DynamicResource HeatmapTooltips}" IsChecked="{Binding HeatmapTooltipsEnabled}" Style="{StaticResource PillToggle}" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource HeatmapTooltips}" />
                  </StackPanel>
                </Grid>
                <local:KeyboardHeatmap Snapshot="{Binding HeatmapSnapshot}" TooltipsEnabled="{Binding HeatmapTooltipsEnabled}" HorizontalAlignment="Stretch" Margin="0,18,0,0" AutomationProperties.Name="{DynamicResource KeyboardHeatmap}" />
              </StackPanel>
            </Border>

            <Border x:Name="HomeFunStatsPanel" Style="{StaticResource Card}" DataContext="{Binding Statistics}"
                    Visibility="{Binding FunStatsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource FunStats}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{DynamicResource FunStatsIntro}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox ItemsSource="{Binding HomeFunStatsPeriodOptions}" SelectedIndex="{Binding HomeFunStatsPeriodIndex}" Width="145" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Shuffle}" Click="ShuffleFunStats_Click" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource FunManage}" Click="ManageFunStats_Click" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Copy}" Tag="home" Click="CopyFunStats_Click" Style="{StaticResource AccentButton}"
                            ToolTipService.InitialShowDelay="1000" AutomationProperties.HelpText="{DynamicResource FunCopyTooltip}">
                      <Button.ToolTip><ToolTip><TextBlock Text="{DynamicResource FunCopyTooltip}" TextWrapping="Wrap" MaxWidth="330" /></ToolTip></Button.ToolTip>
                    </Button>
                  </WrapPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding HomeFunStatsTiles}" AutomationProperties.Name="{DynamicResource FunStats}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource FunStatTileCard}">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Value}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
                          <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" MinHeight="32" />
                          <ContentControl Content="{Binding}" Style="{StaticResource FunStatProgressVisual}" Margin="0,9,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Grid.Column="0">
                <StackPanel>
                  <TextBlock Text="{DynamicResource ActiveSoundPack}" Style="{StaticResource SectionTitle}" />
                  <ComboBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}" DisplayMemberPath="Name" />
                  <TextBlock Text="{Binding ActivePackDescription}" Style="{StaticResource MutedText}" Margin="0,10,0,12" />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource Previous}" Command="{Binding PreviousPackCommand}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Next}" Command="{Binding NextPackCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Grid.Column="2">
                <StackPanel>
                  <Grid><TextBlock Text="{DynamicResource MasterVolume}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding MasterVolumeLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                  <Slider Minimum="0" Maximum="100" Value="{Binding MasterVolume, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" />
                  <CheckBox Content="{DynamicResource KeyboardSounds}" IsChecked="{Binding KeyboardEnabled}" />
                  <CheckBox Content="{DynamicResource PointerButtonSounds}" IsChecked="{Binding PointerEnabled}" />
                  <CheckBox Content="{DynamicResource WheelSounds}" IsChecked="{Binding WheelEnabled}" />
                  <Separator Margin="0,8" />
                  <CheckBox Content="{DynamicResource KeyboardStatistics}" IsChecked="{Binding KeyboardStatisticsEnabled}" />
                  <CheckBox Content="{DynamicResource PointerStatistics}" IsChecked="{Binding PointerStatisticsEnabled}" />
                  <CheckBox Content="{DynamicResource ScrollingStatistics}" IsChecked="{Binding ScrollingStatisticsEnabled}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource AudioOutput}" Style="{StaticResource SectionTitle}" />
                <ComboBox ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding OutputDeviceId}" />
                <TextBlock Text="{DynamicResource AudioOutputHelp}" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}" DataContext="{Binding Statistics}">
            <TextBlock Text="{DynamicResource NavStatistics}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource StatisticsIntro}" Style="{StaticResource PageIntro}" />
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0">
                  <StackPanel Width="180" Margin="0,0,12,0"><TextBlock Text="{DynamicResource Period}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding PeriodOptions}" SelectedIndex="{Binding PeriodIndex}" /></StackPanel>
                  <StackPanel Width="205" Margin="0,0,12,0"><TextBlock Text="{DynamicResource CompareWith}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ComparisonOptions}" SelectedIndex="{Binding ComparisonIndex}" IsEnabled="{Binding ComparisonEnabled}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Visibility="{Binding CustomDatesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Width="150" Margin="0,0,8,0"><TextBlock Text="{DynamicResource From}" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding CustomStart}" /></StackPanel>
                    <StackPanel Width="150"><TextBlock Text="{DynamicResource To}" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding CustomEnd}" /></StackPanel>
                  </StackPanel>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,0,0">
                  <Button Content="{DynamicResource ExportCsv}" Click="ExportStatistics_Click" Margin="0,0,8,0" />
                  <Button Content="{DynamicResource DeleteStatistics}" Click="DeleteStatistics_Click" Style="{StaticResource DangerButton}" />
                </StackPanel>
              </Grid>
            </Border>

            <TabControl x:Name="StatisticsSectionTabs" Style="{StaticResource StatisticsSectionTabControl}" Margin="0,0,0,8" SelectionChanged="StatisticsSectionTabs_SelectionChanged">
              <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource SectionTabItem}"><Setter Property="Visibility" Value="Visible" /></Style>
              </TabControl.ItemContainerStyle>
              <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource StatisticsTabIcon}" /><TextBlock Text="{DynamicResource StatisticsOverview}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                  <UniformGrid Columns="4" Margin="-5,-5,-5,11">
                    <Button Style="{StaticResource MetricCardButton}" Tag="keyboard" Click="MetricCard_Click" AutomationProperties.Name="{DynamicResource KeyboardPresses}"><StackPanel><TextBlock Text="{DynamicResource KeyboardPresses}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding KeyboardCount}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{Binding KeyboardComparison}" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding KeyboardFunFact}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Button>
                    <Button Style="{StaticResource MetricCardButton}" Tag="pointer" Click="MetricCard_Click" AutomationProperties.Name="{DynamicResource PointerClicks}"><StackPanel><TextBlock Text="{DynamicResource PointerClicks}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding PointerCount}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{Binding PointerComparison}" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding PointerFunFact}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Button>
                    <Button Style="{StaticResource MetricCardButton}" Tag="active" Click="MetricCard_Click" AutomationProperties.Name="{DynamicResource ActiveTime}"><StackPanel><TextBlock Text="{DynamicResource ActiveTime}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ActiveTime}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveFunFact}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Button>
                    <Button Style="{StaticResource MetricCardButton}" Tag="scrolling" Click="MetricCard_Click" AutomationProperties.Name="{DynamicResource Scrolling}"><StackPanel><TextBlock Text="{DynamicResource Scrolling}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ScrollingCount}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{Binding ScrollingFunFact}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Button>
                    <Button Style="{StaticResource MetricCardButton}" Tag="average-typing" Click="MetricCard_Click" AutomationProperties.Name="{DynamicResource AverageTyping}"><StackPanel><TextBlock Text="{DynamicResource AverageTyping}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding AverageTypingSpeed}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding AverageTypingFunFact}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Button>
                    <Button Style="{StaticResource MetricCardButton}" Tag="peak-typing" Click="MetricCard_Click" AutomationProperties.Name="{DynamicResource PeakTyping}"><StackPanel><TextBlock Text="{DynamicResource PeakTyping}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding PeakTypingSpeed}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding PeakTypingFunFact}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Button>
                    <Button Style="{StaticResource MetricCardButton}" Tag="average-clicking" Click="MetricCard_Click" AutomationProperties.Name="{DynamicResource AverageClicking}"><StackPanel><TextBlock Text="{DynamicResource AverageClicking}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding AverageClickingSpeed}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding AverageClickingFunFact}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Button>
                    <Button Style="{StaticResource MetricCardButton}" Tag="busiest-hour" Click="MetricCard_Click" AutomationProperties.Name="{DynamicResource BusiestHour}"><StackPanel><TextBlock Text="{DynamicResource BusiestHour}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding BusiestHour}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding BusiestHourFunFact}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Button>
                  </UniformGrid>
                  <Border x:Name="StatisticsFunStatsPanel" Style="{StaticResource Card}"
                          Visibility="{Binding FunStatsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{DynamicResource FunStats}" Style="{StaticResource SectionTitle}" />
                          <TextBlock Text="{DynamicResource FunStatsIntro}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                          <Button Content="{DynamicResource Shuffle}" Click="ShuffleFunStats_Click" Margin="0,0,8,0" />
                          <Button Content="{DynamicResource FunManage}" Click="ManageFunStats_Click" Margin="0,0,8,0" />
                          <Button Content="{DynamicResource Copy}" Tag="statistics" Click="CopyFunStats_Click" Style="{StaticResource AccentButton}"
                                  ToolTipService.InitialShowDelay="1000" AutomationProperties.HelpText="{DynamicResource FunCopyTooltip}">
                            <Button.ToolTip><ToolTip><TextBlock Text="{DynamicResource FunCopyTooltip}" TextWrapping="Wrap" MaxWidth="330" /></ToolTip></Button.ToolTip>
                          </Button>
                        </WrapPanel>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding FunStatsTiles}" AutomationProperties.Name="{DynamicResource FunStats}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource FunStatTileCard}">
                              <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Value}" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" MinHeight="32" />
                                <ContentControl Content="{Binding}" Style="{StaticResource FunStatProgressVisual}" Margin="0,9,0,0" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource ActivityChart}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                          <ComboBox ItemsSource="{Binding ChartMetricFamilyOptions}" SelectedIndex="{Binding ChartMetricFamilyIndex}" Width="125" Margin="0,0,8,0" />
                          <ComboBox ItemsSource="{Binding ChartViewOptions}" DisplayMemberPath="Label" SelectedIndex="{Binding ChartViewTypeIndex}" Width="105" Margin="0,0,8,0">
                            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsEnabled}" /></Style></ComboBox.ItemContainerStyle>
                          </ComboBox>
                          <ComboBox ItemsSource="{Binding ChartGranularityOptions}" DisplayMemberPath="Label" SelectedIndex="{Binding ChartGranularityIndex}" Width="115" Margin="0,0,8,0">
                            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsEnabled}" /></Style></ComboBox.ItemContainerStyle>
                          </ComboBox>
                          <Button Content="{DynamicResource Customize}" Click="CustomizeChart_Click" />
                        </WrapPanel>
                      </Grid>
                      <local:ActivityChart Model="{Binding ChartModel}" ReducedMotion="{Binding ReducedMotion}" Height="270" AutomationProperties.Name="{DynamicResource ActivityChart}"
                                           AutomationProperties.HelpText="{Binding ChartAccessibleSummary}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>
              <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE962;" Style="{StaticResource StatisticsTabIcon}" /><TextBlock Text="{DynamicResource StatisticsPointer}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource PointerDeviceFilter}" Style="{StaticResource FormRowLabel}" />
                    <ComboBox ItemsSource="{Binding PointerDeviceFilterOptions}" SelectedIndex="{Binding PointerDeviceFilterIndex}" Width="220" />
                  </StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource PointerBreakdown}" Style="{StaticResource SectionTitle}" /><ListView ItemsSource="{Binding PointerRows}" Background="Transparent" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="{DynamicResource Input}" DisplayMemberBinding="{Binding Label}" Width="180" /><GridViewColumn Header="{DynamicResource Device}" DisplayMemberBinding="{Binding Detail}" Width="150" /><GridViewColumn Header="{DynamicResource Count}" DisplayMemberBinding="{Binding Count}" Width="90" /></GridView></ListView.View></ListView></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource ClickingSpeed}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding AverageClickingSpeed}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource AverageCpsHelp}" Style="{StaticResource MutedText}" Margin="0,3,0,14" /><TextBlock Text="{Binding PeakClickingSpeed}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PeakCpsHelp}" Style="{StaticResource MutedText}" /></StackPanel></Border>
                  </Grid>
                </StackPanel>
              </TabItem>
              <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" Style="{StaticResource StatisticsTabIcon}" /><TextBlock Text="{DynamicResource StatisticsKeyboard}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
                <StackPanel Margin="0,14,0,0">
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource KeyboardHeatmap}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                          <Button Content="?" Style="{StaticResource HelpIconButton}" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource KeyboardHeatmapInformation}">
