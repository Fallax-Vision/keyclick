                              <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Total}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding TotalActivity, StringFormat={}{0:N0}}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" /></StackPanel>
