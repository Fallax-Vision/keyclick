                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding RotationCustomVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource CustomMinutes}" Style="{StaticResource FormRowLabel}" />
                  <TextBox Grid.Column="1" Text="{Binding RotationCustomMinutes, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource RotationPool}" Style="{StaticResource FormRowLabel}" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding RotationPoolModes}" SelectedIndex="{Binding RotationPoolModeIndex}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding RotationPackOptions}" Margin="200,8,0,0" Visibility="{Binding RotationSelectedPoolVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate>
