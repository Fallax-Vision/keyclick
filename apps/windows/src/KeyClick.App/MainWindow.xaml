                  <TextBlock Text="{DynamicResource ChallengeNew}" Style="{StaticResource SectionTitle}" />
                  <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource ChallengeSource}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding SourceIndex}" /></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Language}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding LanguageIndex}" /></StackPanel>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource ChallengeDifficulty}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding DifficultyOptions}" SelectedIndex="{Binding DifficultyIndex}" /></StackPanel>
                    <StackPanel><TextBlock Text="{DynamicResource ChallengeMistakes}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding MistakeModeOptions}" SelectedIndex="{Binding MistakeModeIndex}" /></StackPanel>
                  </UniformGrid>

                  <StackPanel Visibility="{Binding BuiltInVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,16,0,0">
                    <TextBlock Text="{DynamicResource ChallengePassage}" Style="{StaticResource FieldLabel}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <ComboBox ItemsSource="{Binding PassageOptions}" SelectedItem="{Binding SelectedPassage}" DisplayMemberPath="Title" />
                      <Button Grid.Column="1" Content="{DynamicResource ChallengeRandom}" Click="ChallengeRandom_Click" Margin="10,0,0,0" />
                      <Button Grid.Column="2" Content="{DynamicResource ChallengeFavorite}" Click="ChallengeFavorite_Click" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding SelectedPassage.Text}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                  </StackPanel>

                  <StackPanel Visibility="{Binding CustomVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,16,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="{DynamicResource ChallengePromptTitle}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding CustomPromptTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" /></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource ChallengeSavedPrompts}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding SavedPrompts}" SelectedItem="{Binding SelectedSavedPrompt}" DisplayMemberPath="Title" /></StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource ChallengeCustomText}" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                    <TextBox Text="{Binding CustomPromptText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="130" MaxLength="50000" />
                    <CheckBox Content="{DynamicResource ChallengeSavePrompt}" IsChecked="{Binding SaveCustomPrompt}" Margin="0,10,0,0" />
                    <TextBlock Text="{DynamicResource ChallengeSavePromptHelp}" Style="{StaticResource MutedText}" Margin="22,3,0,0" />
                  </StackPanel>

                  <TextBlock Text="{DynamicResource ChallengeFreeWritingHelp}" Style="{StaticResource MutedText}" Margin="0,16,0,0"
                             Visibility="{Binding FreeWritingVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource ChallengeRules}" Style="{StaticResource SectionTitle}" />
                  <Grid Visibility="{Binding ReferenceTextVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource ChallengeRunMode}" Style="{StaticResource FormRowLabel}" /><ComboBox Grid.Column="1" ItemsSource="{Binding RunModeOptions}" SelectedIndex="{Binding RunModeIndex}" />
                  </Grid>
                  <CheckBox Content="{DynamicResource ChallengeTimedFreeWriting}" IsChecked="{Binding FreeWritingTimed}" Margin="0,0,0,10"
                            Visibility="{Binding FreeWritingVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Grid Visibility="{Binding TimedOptionsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource ChallengeDuration}" Style="{StaticResource FormRowLabel}" /><ComboBox Grid.Column="1" ItemsSource="{Binding DurationOptions}" SelectedIndex="{Binding DurationIndex}" />
                    <TextBox Grid.Column="3" Text="{Binding CustomDurationSeconds, UpdateSourceTrigger=LostFocus}" Visibility="{Binding CustomDurationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                  <WrapPanel Margin="0,14,0,0">
                    <CheckBox Content="{DynamicResource ChallengeSaveResult}" IsChecked="{Binding SaveResult}" Margin="0,0,22,0" />
                    <CheckBox Content="{DynamicResource ChallengeCompareResult}" IsChecked="{Binding CompareResult}" />
                  </WrapPanel>
                  <StackPanel Width="260" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <TextBlock Text="{DynamicResource ChallengeNormalPeriod}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding NormalComparisonPeriodOptions}" SelectedIndex="{Binding NormalComparisonPeriodIndex}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{DynamicResource ChallengePerformanceGoal}" Style="{StaticResource FieldLabel}" /><WrapPanel><TextBox Text="{Binding GoalWordsPerMinute, UpdateSourceTrigger=LostFocus}" Width="90" /><TextBlock Text="WPM" VerticalAlignment="Center" Margin="8,0,16,0" /><TextBox Text="{Binding GoalAccuracy, UpdateSourceTrigger=LostFocus}" Width="90" /><TextBlock Text="%" VerticalAlignment="Center" Margin="8,0,0,0" /></WrapPanel></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource ChallengeStatisticsPolicy}" Style="{StaticResource FieldLabel}" /><CheckBox Content="{DynamicResource IncludeChallengeTypingStatistics}" IsChecked="{Binding IncludeChallengeTypingInStatistics}" /><TextBlock Text="{DynamicResource IncludeChallengeTypingStatisticsHelp}" Style="{StaticResource MutedText}" Margin="22,3,0,0" /></StackPanel>
                  <Button Grid.Column="3" Content="{DynamicResource ChallengeStart}" Click="ChallengeStart_Click" Style="{StaticResource AccentButton}" MinWidth="150" Margin="24,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding ActiveVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <UniformGrid Columns="4" Margin="-5,-5,-5,11">
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ChallengeNetWpm}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding LiveWpm}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ChallengeAccuracy}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding LiveAccuracy}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ChallengeElapsed}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Elapsed}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ChallengeRemaining}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Remaining}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
              </UniformGrid>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource ChallengeTypePrompt}" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="ChallengeTargetText" Text="{Binding TargetText}" FontSize="19" LineHeight="30" TextWrapping="Wrap" Padding="4" Margin="0,0,0,16" />
                  <TextBox x:Name="ChallengeInput" Text="{Binding ResponseText, Mode=OneWay}" FontSize="18" Height="150" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" PreviewTextInput="ChallengeInput_PreviewTextInput"
                           PreviewKeyDown="ChallengeInput_PreviewKeyDown" PreviewKeyUp="ChallengeInput_PreviewKeyUp" />
                  <TextBlock Text="{DynamicResource ChallengeResponsePrivateHelp}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                  <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="{DynamicResource Resume}" Click="ChallengeResume_Click" Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource AccentButton}" Margin="0,0,10,0" />
                    <Button Content="{DynamicResource ChallengeFinish}" Click="ChallengeFinish_Click" Margin="0,0,10,0" />
                    <Button Content="{DynamicResource Cancel}" Click="ChallengeCancel_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding ResultsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <UniformGrid Columns="4" Margin="-5,-5,-5,11">
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ChallengeNetWpm}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ResultWpm}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ChallengeGrossWpm}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ResultGrossWpm}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ChallengeAccuracy}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ResultAccuracy}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ChallengeConsistency}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ResultConsistency}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
              </UniformGrid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource ChallengeSpeedChart}" Style="{StaticResource SectionTitle}" /><local:TypingSpeedChart Samples="{Binding ResultSamples}" Height="220" /><TextBlock Text="{Binding ResultCounts}" Style="{StaticResource MutedText}" Margin="0,10,0,0" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource ChallengeComparisons}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding PreviousComparison}" Margin="0,0,0,10" /><TextBlock Text="{Binding BestComparison}" Margin="0,0,0,10" /><TextBlock Text="{Binding SelectedComparison}" Margin="0,0,0,10" /><TextBlock Text="{Binding NormalComparison}" Margin="0,0,0,16" /><TextBlock Text="{DynamicResource ChallengeParticipationStreak}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ParticipationStreak}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,10" /><TextBlock Text="{DynamicResource ChallengePerformanceStreak}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding PerformanceStreak}" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
              </Grid>
              <WrapPanel HorizontalAlignment="Right"><Button Content="{DynamicResource ChallengeAgain}" Click="ChallengeShowSetup_Click" Style="{StaticResource AccentButton}" Margin="0,0,10,0" /><Button Content="{DynamicResource ChallengeHistory}" Click="ChallengeShowHistory_Click" /></WrapPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding HistoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <WrapPanel>
                    <StackPanel Width="180" Margin="0,0,12,0"><TextBlock Text="{DynamicResource Period}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding HistoryPeriodOptions}" SelectedIndex="{Binding HistoryPeriodIndex}" /></StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,0"><TextBlock Text="{DynamicResource ChallengeSource}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding HistorySourceOptions}" SelectedIndex="{Binding HistorySourceIndex}" /></StackPanel>
                    <StackPanel Width="210"><TextBlock Text="{DynamicResource ChallengeRunMode}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding HistoryModeOptions}" SelectedIndex="{Binding HistoryModeIndex}" /></StackPanel>
                  </WrapPanel>
                  <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="{DynamicResource ExportCsv}" Click="ChallengeExport_Click" Margin="0,0,10,0" /><Button Content="{DynamicResource ChallengeCompareSelected}" Click="ChallengeCompareSelected_Click" IsEnabled="{Binding CanDeleteSelected}" Margin="0,0,18,0" /><Button Content="{DynamicResource ChallengeDeleteSelected}" Click="ChallengeDeleteSelected_Click" IsEnabled="{Binding CanDeleteSelected}" Style="{StaticResource DangerButton}" Margin="0,0,10,0" /><Button Content="{DynamicResource ChallengeDeletePeriod}" Click="ChallengeDeletePeriod_Click" Style="{StaticResource DangerButton}" /></WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="{DynamicResource ChallengeHistory}" Style="{StaticResource SectionTitle}" />
                  <ListView ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" Background="Transparent" BorderThickness="0" MinHeight="200" MaxHeight="420">
                    <ListView.View><GridView><GridViewColumn Header="{DynamicResource Date}" DisplayMemberBinding="{Binding CompletedUtc}" Width="180" /><GridViewColumn Header="{DynamicResource ChallengeSource}" DisplayMemberBinding="{Binding Source}" Width="110" /><GridViewColumn Header="WPM" DisplayMemberBinding="{Binding NetWordsPerMinute}" Width="100" /><GridViewColumn Header="{DynamicResource ChallengeAccuracy}" DisplayMemberBinding="{Binding AccuracyPercent}" Width="110" /><GridViewColumn Header="{DynamicResource ChallengeDuration}" DisplayMemberBinding="{Binding ActiveMilliseconds}" Width="130" /><GridViewColumn Header="{DynamicResource ChallengePassage}" DisplayMemberBinding="{Binding PromptTitle}" Width="220" /></GridView></ListView.View>
                  </ListView>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{DynamicResource ChallengeSavedPrompts}" Style="{StaticResource SectionTitle}" /><ListBox ItemsSource="{Binding SavedPrompts}" SelectedItem="{Binding SelectedSavedPrompt}" DisplayMemberPath="Title" Background="Transparent" BorderThickness="0" MinHeight="80" /></StackPanel>
                  <Button Grid.Column="1" Content="{DynamicResource RemoveSelected}" Click="ChallengeDeletePrompt_Click" VerticalAlignment="Bottom" Margin="18,0,0,0" />
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
