                <ListBox x:Name="IntegrationClientList" ItemsSource="{Binding AllowedIntegrationClients}" Background="Transparent" BorderThickness="0" MinHeight="90" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource OutcomeModel}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource OutcomeHelp}" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{DynamicResource NavAbout}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource AboutIntro}" Style="{StaticResource PageIntro}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="KeyClick" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,10" />
                <TextBlock Text="C# · WPF · .NET 10 LTS · SQLite · Raw Input · XAudio2" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Updates}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource UpdatesHelp}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding AvailableUpdateText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,10"
                           Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <WrapPanel>
                  <Button Content="{DynamicResource CheckUpdates}" Click="CheckUpdates_Click" Margin="0,0,8,0" />
                  <Button Content="{DynamicResource UpdateNow}" Click="UpdateNow_Click" Style="{StaticResource AccentButton}"
                          Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource BackupDiagnostics}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource BackupHelp}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                <WrapPanel><Button Content="{DynamicResource CreateBackup}" Command="{Binding BackupCommand}" /><Button Content="{DynamicResource RestoreBackup}" Click="RestoreBackup_Click" Margin="8,0,0,0" /><Button Content="{DynamicResource OpenDataFolder}" Click="OpenDataFolder_Click" Margin="8,0,0,0" /></WrapPanel>
                <TextBlock Text="{Binding DataLocation}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource ProfilePortability}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource ProfilePortabilityHelp}" Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <WrapPanel><Button Content="{DynamicResource ExportProfile}" Click="ExportProfile_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0" /><Button Content="{DynamicResource ImportProfile}" Click="ImportProfile_Click" Margin="0,0,8,0" /><Button Content="{DynamicResource UseInstalledData}" Click="UseInstalledData_Click" Visibility="{Binding IsPortable, Converter={StaticResource BooleanToVisibilityConverter}}" /></WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Privacy}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource PrivacyHelp}" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
