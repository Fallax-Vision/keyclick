<Window x:Class="KeyClick.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyClick.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding AppTitle}" Width="1160" Height="780" MinWidth="940" MinHeight="650"
        Icon="pack://application:,,,/Assets/keyclick.ico"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged" SourceInitialized="Window_SourceInitialized">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="18" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
          <Image Width="34" Height="34" Source="pack://application:,,,/Assets/keyclick-icon.png"
                 Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="Fant" />
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding AppTitle}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" MaxWidth="135" />
            <TextBlock Text="{DynamicResource AppTagline}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,10" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="{Binding SoundStateText}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActivePackName}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="0" Checked="Navigation_Checked" IsChecked="True" AutomationProperties.Name="{DynamicResource NavHome}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavHome}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="2" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavSoundPacks}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavSoundPacks}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="3" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavMappings}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE92E;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavMappings}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="4" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavShortcuts}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavShortcuts}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="1" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavStatistics}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavStatistics}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="5" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavSettings}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavSettings}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="6" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavIntegrations}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavIntegrations}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="PrimaryNavigation" Tag="7" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource NavAbout}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource NavigationIcon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{DynamicResource NavAbout}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="3">
          <Button Content="{DynamicResource ToggleAllSounds}" Command="{Binding ToggleSoundsCommand}" />
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="2,10,2,0" MaxHeight="54" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="PageTabs" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="PageTabs_SelectionChanged">
      <TabControl.Resources>
        <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
      </TabControl.Resources>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{DynamicResource NavHome}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource HomeIntro}" Style="{StaticResource PageIntro}" />

            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding SoundStateText}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SoundStateDescription}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource ToggleSounds}" Command="{Binding ToggleSoundsCommand}"
                        Style="{StaticResource AccentButton}" MinWidth="140" Margin="24,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Grid.Column="0">
                <StackPanel>
                  <TextBlock Text="{DynamicResource ActiveSoundPack}" Style="{StaticResource SectionTitle}" />
                  <ComboBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}" DisplayMemberPath="Name" />
                  <TextBlock Text="{Binding ActivePackDescription}" Style="{StaticResource MutedText}" Margin="0,10,0,12" />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource Previous}" Command="{Binding PreviousPackCommand}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Next}" Command="{Binding NextPackCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Grid.Column="2">
                <StackPanel>
                  <Grid><TextBlock Text="{DynamicResource MasterVolume}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding MasterVolumeLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                  <Slider Minimum="0" Maximum="100" Value="{Binding MasterVolume, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" />
                  <CheckBox Content="{DynamicResource KeyboardSounds}" IsChecked="{Binding KeyboardEnabled}" />
                  <CheckBox Content="{DynamicResource PointerButtonSounds}" IsChecked="{Binding PointerEnabled}" />
                  <CheckBox Content="{DynamicResource WheelSounds}" IsChecked="{Binding WheelEnabled}" />
                  <Separator Margin="0,8" />
                  <CheckBox Content="{DynamicResource KeyboardStatistics}" IsChecked="{Binding KeyboardStatisticsEnabled}" />
                  <CheckBox Content="{DynamicResource PointerStatistics}" IsChecked="{Binding PointerStatisticsEnabled}" />
                  <CheckBox Content="{DynamicResource ScrollingStatistics}" IsChecked="{Binding ScrollingStatisticsEnabled}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" DataContext="{Binding Statistics}">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource KeyboardHeatmap}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                    <Button Content="?" Style="{StaticResource HelpIconButton}" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource KeyboardHeatmapInformation}">
                      <Button.ToolTip>
                        <ToolTip><TextBlock Text="{DynamicResource KeyboardHeatmapHelp}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                      </Button.ToolTip>
                    </Button>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource HeatmapDuration}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox ItemsSource="{Binding HeatmapPeriodOptions}" SelectedIndex="{Binding HeatmapPeriodIndex}" Width="150" AutomationProperties.Name="{DynamicResource HeatmapDuration}" />
                    </StackPanel>
                    <ToggleButton Content="{DynamicResource HeatmapTooltips}" IsChecked="{Binding HeatmapTooltipsEnabled}" Style="{StaticResource PillToggle}" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource HeatmapTooltips}" />
                  </StackPanel>
                </Grid>
                <local:KeyboardHeatmap Snapshot="{Binding HeatmapSnapshot}" TooltipsEnabled="{Binding HeatmapTooltipsEnabled}" Height="218" Margin="0,18,0,0" AutomationProperties.Name="{DynamicResource KeyboardHeatmap}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource AudioOutput}" Style="{StaticResource SectionTitle}" />
                <ComboBox ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding OutputDeviceId}" />
                <TextBlock Text="{DynamicResource AudioOutputHelp}" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}" DataContext="{Binding Statistics}">
            <TextBlock Text="{DynamicResource NavStatistics}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource StatisticsIntro}" Style="{StaticResource PageIntro}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <WrapPanel>
                  <StackPanel Width="180" Margin="0,0,12,0"><TextBlock Text="{DynamicResource Period}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding PeriodOptions}" SelectedIndex="{Binding PeriodIndex}" /></StackPanel>
                  <StackPanel Width="205" Margin="0,0,12,0"><TextBlock Text="{DynamicResource CompareWith}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ComparisonOptions}" SelectedIndex="{Binding ComparisonIndex}" IsEnabled="{Binding ComparisonEnabled}" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Visibility="{Binding CustomDatesVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Width="150" Margin="0,0,8,0"><TextBlock Text="{DynamicResource From}" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding CustomStart}" /></StackPanel>
                    <StackPanel Width="150"><TextBlock Text="{DynamicResource To}" Style="{StaticResource FieldLabel}" /><DatePicker SelectedDate="{Binding CustomEnd}" /></StackPanel>
                  </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="{DynamicResource Refresh}" Click="RefreshStatistics_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                  <Button Content="{DynamicResource ExportCsv}" Click="ExportStatistics_Click" Margin="0,0,8,0" />
                  <Button Content="{DynamicResource DeleteStatistics}" Click="DeleteStatistics_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <TabControl x:Name="StatisticsSectionTabs" Background="Transparent" BorderThickness="0" Margin="0,0,0,8" SelectionChanged="StatisticsSectionTabs_SelectionChanged">
              <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource SectionTabItem}"><Setter Property="Visibility" Value="Visible" /></Style>
              </TabControl.ItemContainerStyle>
              <TabItem Header="{DynamicResource StatisticsOverview}">
                <StackPanel Margin="0,14,0,0">
                  <UniformGrid Columns="4" Margin="-5,-5,-5,11">
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource KeyboardPresses}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding KeyboardCount}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{Binding KeyboardComparison}" Foreground="{DynamicResource AccentBrush}" /></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource PointerClicks}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding PointerCount}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{Binding PointerComparison}" Foreground="{DynamicResource AccentBrush}" /></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource ActiveTime}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ActiveTime}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource Scrolling}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding ScrollingCount}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource AverageTyping}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding AverageTypingSpeed}" FontSize="21" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource PeakTyping}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding PeakTypingSpeed}" FontSize="21" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource AverageClicking}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding AverageClickingSpeed}" FontSize="21" FontWeight="SemiBold" /></StackPanel></Border>
                    <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="{DynamicResource BusiestHour}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding BusiestHour}" FontSize="21" FontWeight="SemiBold" /></StackPanel></Border>
                  </UniformGrid>
                  <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="{DynamicResource ActivityChart}" Style="{StaticResource SectionTitle}" /><local:ActivityChart Snapshot="{Binding Snapshot}" Height="230" AutomationProperties.Name="{DynamicResource ActivityChart}" /></StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>
              <TabItem Header="{DynamicResource StatisticsPointer}">
                <StackPanel Margin="0,14,0,0">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource PointerDeviceFilter}" Style="{StaticResource FormRowLabel}" />
                    <ComboBox ItemsSource="{Binding PointerDeviceFilterOptions}" SelectedIndex="{Binding PointerDeviceFilterIndex}" Width="220" />
                  </StackPanel>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource PointerBreakdown}" Style="{StaticResource SectionTitle}" /><ListView ItemsSource="{Binding PointerRows}" Background="Transparent" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="{DynamicResource Input}" DisplayMemberBinding="{Binding Label}" Width="180" /><GridViewColumn Header="{DynamicResource Device}" DisplayMemberBinding="{Binding Detail}" Width="150" /><GridViewColumn Header="{DynamicResource Count}" DisplayMemberBinding="{Binding Count}" Width="90" /></GridView></ListView.View></ListView></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource ClickingSpeed}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding AverageClickingSpeed}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource AverageCpsHelp}" Style="{StaticResource MutedText}" Margin="0,3,0,14" /><TextBlock Text="{Binding PeakClickingSpeed}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PeakCpsHelp}" Style="{StaticResource MutedText}" /></StackPanel></Border>
                  </Grid>
                </StackPanel>
              </TabItem>
              <TabItem Header="{DynamicResource StatisticsKeyboard}">
                <StackPanel Margin="0,14,0,0">
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource KeyboardHeatmap}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                          <Button Content="?" Style="{StaticResource HelpIconButton}" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource KeyboardHeatmapInformation}">
                            <Button.ToolTip>
                              <ToolTip><TextBlock Text="{DynamicResource KeyboardHeatmapHelp}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                            </Button.ToolTip>
                          </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource HeatmapDuration}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding HeatmapPeriodOptions}" SelectedIndex="{Binding HeatmapPeriodIndex}" Width="150" AutomationProperties.Name="{DynamicResource HeatmapDuration}" />
                          </StackPanel>
                          <ToggleButton Content="{DynamicResource HeatmapTooltips}" IsChecked="{Binding HeatmapTooltipsEnabled}" Style="{StaticResource PillToggle}" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource HeatmapTooltips}" />
                        </StackPanel>
                      </Grid>
                      <local:KeyboardHeatmap Snapshot="{Binding HeatmapSnapshot}" TooltipsEnabled="{Binding HeatmapTooltipsEnabled}" Height="218" Margin="0,18,0,0" AutomationProperties.Name="{DynamicResource KeyboardHeatmap}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource KeyBreakdown}" Style="{StaticResource SectionTitle}" /><ListView ItemsSource="{Binding KeyboardRows}" Background="Transparent" BorderThickness="0" MaxHeight="240"><ListView.View><GridView><GridViewColumn Header="{DynamicResource Key}" DisplayMemberBinding="{Binding Label}" Width="180" /><GridViewColumn Header="{DynamicResource Group}" DisplayMemberBinding="{Binding Detail}" Width="190" /><GridViewColumn Header="{DynamicResource Count}" DisplayMemberBinding="{Binding Count}" Width="100" /></GridView></ListView.View></ListView></StackPanel></Border>
                </StackPanel>
              </TabItem>
              <TabItem Header="{DynamicResource StatisticsWellness}">
                <StackPanel Margin="0,14,0,0">
                  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource WellnessEssentials}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource WellnessDisabledHelp}" Style="{StaticResource MutedText}" /><CheckBox Content="{DynamicResource EnableWellness}" IsChecked="{Binding DataContext.WellnessEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,10,0,0" /></StackPanel></Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                      <TextBlock Text="{DynamicResource DailyGoals}" Style="{StaticResource SectionTitle}" />
                      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="12" /><ColumnDefinition Width="140" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CheckBox Content="{DynamicResource KeyboardGoal}" IsChecked="{Binding KeyboardGoalEnabled}" /><TextBox Grid.Column="2" Text="{Binding KeyboardDailyGoal, UpdateSourceTrigger=LostFocus}" /><TextBlock Grid.Column="4" Text="{DynamicResource PressesPerDay}" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></Grid>
                      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="12" /><ColumnDefinition Width="140" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CheckBox Content="{DynamicResource PointerGoal}" IsChecked="{Binding PointerGoalEnabled}" /><TextBox Grid.Column="2" Text="{Binding PointerDailyGoal, UpdateSourceTrigger=LostFocus}" /><TextBlock Grid.Column="4" Text="{DynamicResource ClicksPerDay}" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></Grid>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="12" /><ColumnDefinition Width="140" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CheckBox Content="{DynamicResource ActiveTimeGoal}" IsChecked="{Binding ActiveMinutesGoalEnabled}" /><TextBox Grid.Column="2" Text="{Binding ActiveMinutesDailyGoal, UpdateSourceTrigger=LostFocus}" /><TextBlock Grid.Column="4" Text="{DynamicResource MinutesPerDay}" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></Grid>
                      <TextBlock Text="{Binding WellnessTodaySummary}" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,3" />
                      <TextBlock Text="{Binding WellnessStreakSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}">
                    <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                      <TextBlock Text="{DynamicResource BreakReminder}" Style="{StaticResource SectionTitle}" />
                      <CheckBox Content="{DynamicResource EnableBreakReminder}" IsChecked="{Binding BreakReminderEnabled}" />
                      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="12" /><ColumnDefinition Width="140" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource ActiveMinutesBeforeReminder}" Style="{StaticResource FormRowLabel}" /><TextBox Grid.Column="2" Text="{Binding BreakReminderActiveMinutes, UpdateSourceTrigger=LostFocus}" /><TextBlock Grid.Column="4" Text="{DynamicResource Minutes}" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></Grid>
                      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="12" /><ColumnDefinition Width="140" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource RestMinutesToRearm}" Style="{StaticResource FormRowLabel}" /><TextBox Grid.Column="2" Text="{Binding BreakReminderRestMinutes, UpdateSourceTrigger=LostFocus}" /><TextBlock Grid.Column="4" Text="{DynamicResource Minutes}" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>
            </TabControl>
            <TextBlock Text="{Binding QueueDiagnostics}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{DynamicResource NavSoundPacks}" Style="{StaticResource PageTitle}" />
            <Grid Margin="0,0,0,22">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource SoundPacksIntro}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,18,0" />
              <Button Grid.Column="1" Content="{DynamicResource ImportSoundPack}" Click="ImportSoundPack_Click" Style="{StaticResource AccentButton}" />
            </Grid>
            <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource CardListBoxItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="4" Background="{Binding AccentHex}" />
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                        <TextBlock Text="{Binding Family}" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <TextBlock Text="{DynamicResource CustomPackBadge}" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{DynamicResource SelectToActivate}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="20,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource AutomaticPackRotation}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource AutomaticPackRotationHelp}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                <CheckBox Content="{DynamicResource EnablePackRotation}" IsChecked="{Binding RotationEnabled}" />
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource RotationInterval}" Style="{StaticResource FormRowLabel}" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding RotationIntervals}" SelectedIndex="{Binding RotationIntervalIndex}" />
                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding RotationCustomVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource CustomMinutes}" Style="{StaticResource FormRowLabel}" />
                  <TextBox Grid.Column="1" Text="{Binding RotationCustomMinutes, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource RotationPool}" Style="{StaticResource FormRowLabel}" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding RotationPoolModes}" SelectedIndex="{Binding RotationPoolModeIndex}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding RotationPackOptions}" Margin="200,8,0,0" Visibility="{Binding RotationSelectedPoolVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="{DynamicResource RotateNow}" Command="{Binding RotatePackNowCommand}" Style="{StaticResource AccentButton}" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding NextRotationTime}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{DynamicResource MappingsTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource MappingsIntro}" Style="{StaticResource PageIntro}" />
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource SelectedInput}" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="{Binding CapturedInputLabel}" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CapturedInputDetail}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource CaptureNextRelease}" Command="{Binding CaptureInputCommand}"
                        Style="{StaticResource AccentButton}" MinWidth="180" Margin="24,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource PerInputOverride}" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource ActionVariant}" Style="{StaticResource FormRowLabel}" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding MappingVariants}" SelectedIndex="{Binding MappingVariantIndex}" />
                </Grid>
                <CheckBox Content="{DynamicResource ApplyWholeGroup}" IsChecked="{Binding ApplyToGroup}" />
                <TextBlock Text="{Binding MappingScopeLabel}" Style="{StaticResource MutedText}" Margin="22,0,0,7" />
                <CheckBox Content="{DynamicResource SoundEnabledInputVariant}" IsChecked="{Binding MappingEnabled}" />
                <Grid Margin="0,10,0,2"><TextBlock Text="{DynamicResource InputVolume}" /><TextBlock Text="{Binding MappingVolume, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                <Slider Minimum="0" Maximum="100" Value="{Binding MappingVolume, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,12,0,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource SoundSource}" Style="{StaticResource FormRowLabel}" />
                  <TextBlock Grid.Column="1" Text="{Binding MappingSound}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
                <WrapPanel>
                  <Button Content="{DynamicResource SaveOverride}" Command="{Binding SaveMappingCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8" />
                  <Button Content="{DynamicResource ImportSoundFormats}" Click="ImportSound_Click" Margin="0,0,8,8" />
                  <Button Content="{DynamicResource Preview}" Command="{Binding PreviewMappingCommand}" Margin="0,0,8,8" />
                  <Button Content="{DynamicResource RestoreBuiltIn}" Command="{Binding RestoreMappingCommand}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource HowVariantsWork}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource VariantsHelp}" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{DynamicResource ShortcutsTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource ShortcutsIntro}" Style="{StaticResource PageIntro}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <ListView ItemsSource="{Binding Shortcuts}" SelectedItem="{Binding SelectedShortcut}" Background="Transparent" BorderThickness="0" MinHeight="230">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="{DynamicResource HeaderAction}" DisplayMemberBinding="{Binding Name}" Width="230" />
                      <GridViewColumn Header="{DynamicResource HeaderShortcut}" Width="210">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedGestureConverter}}" /></DataTemplate></GridViewColumn.CellTemplate>
                      </GridViewColumn>
                      <GridViewColumn Header="{DynamicResource HeaderScope}" Width="85">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Scope, Converter={StaticResource LocalizedEnumConverter}}" /></DataTemplate></GridViewColumn.CellTemplate>
                      </GridViewColumn>
                      <GridViewColumn Header="{DynamicResource HeaderType}" Width="85">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind, Converter={StaticResource LocalizedEnumConverter}}" /></DataTemplate></GridViewColumn.CellTemplate>
                      </GridViewColumn>
                    </GridView>
                  </ListView.View>
                </ListView>
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="{DynamicResource EditSelectedShortcut}" Click="EditShortcut_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
                  <Button Content="{DynamicResource RestoreDefaults}" Click="RestoreShortcuts_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource SequenceTimeout}" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource SequenceTimeoutHelp}" Style="{StaticResource MutedText}" /></StackPanel>
                <TextBox Grid.Column="2" Text="{Binding SequenceTimeoutMs, UpdateSourceTrigger=LostFocus}" ToolTip="{DynamicResource MillisecondsTooltip}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{DynamicResource NavSettings}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource SettingsIntro}" Style="{StaticResource PageIntro}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource IdentityAppearance}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource DisplayName}" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" MaxLength="63" />
                <TextBlock Text="{DynamicResource DisplayLanguage}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding DisplayLanguages}" SelectedIndex="{Binding DisplayLanguageIndex}" />
                <TextBlock Text="{DynamicResource DisplayLanguageHelp}" Style="{StaticResource MutedText}" Margin="0,7,0,14" />
                <TextBlock Text="{DynamicResource Theme}" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ThemeModes}" SelectedIndex="{Binding ThemeIndex}" />
                <CheckBox Content="{DynamicResource ReducedMotion}" IsChecked="{Binding ReducedMotion}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource SoundControls}" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="{DynamicResource EnableAllSounds}" IsChecked="{Binding SoundsEnabled}" />
                <CheckBox Content="{DynamicResource KeyboardSounds}" IsChecked="{Binding KeyboardEnabled}" />
                <CheckBox Content="{DynamicResource PointerButtonSounds}" IsChecked="{Binding PointerEnabled}" />
                <CheckBox Content="{DynamicResource WheelSounds}" IsChecked="{Binding WheelEnabled}" />
                <CheckBox Content="{DynamicResource IntegrationResultSounds}" IsChecked="{Binding ResultSoundsEnabled}" />
                <TextBlock Text="{DynamicResource KeyboardSoundTiming}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                <ComboBox ItemsSource="{Binding KeyboardSoundTimings}" SelectedIndex="{Binding KeyboardSoundTimingIndex}" />
                <Grid Margin="0,12,0,0"><TextBlock Text="{DynamicResource KeyboardVolume}" /><TextBlock Text="{Binding KeyboardVolumeLabel}" HorizontalAlignment="Right" /></Grid>
                <Slider Minimum="0" Maximum="100" Value="{Binding KeyboardVolume, UpdateSourceTrigger=PropertyChanged}" />
                <Grid><TextBlock Text="{DynamicResource PointerVolume}" /><TextBlock Text="{Binding PointerVolumeLabel}" HorizontalAlignment="Right" /></Grid>
                <Slider Minimum="0" Maximum="100" Value="{Binding PointerVolume, UpdateSourceTrigger=PropertyChanged}" />
                <Grid><TextBlock Text="{DynamicResource ResultCueVolume}" /><TextBlock Text="{Binding ResultVolumeLabel}" HorizontalAlignment="Right" /></Grid>
                <Slider Minimum="0" Maximum="100" Value="{Binding ResultVolume, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="{DynamicResource NormalizeImports}" IsChecked="{Binding NormalizeImports}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource StatisticsCapture}" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="{DynamicResource KeyboardStatistics}" IsChecked="{Binding KeyboardStatisticsEnabled}" />
                <CheckBox Content="{DynamicResource PointerStatistics}" IsChecked="{Binding PointerStatisticsEnabled}" />
                <CheckBox Content="{DynamicResource ScrollingStatistics}" IsChecked="{Binding ScrollingStatisticsEnabled}" />
                <TextBlock Text="{DynamicResource StatisticsExclusions}" FontWeight="SemiBold" Margin="0,12,0,5" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="StatisticsExclusionPath" ToolTip="{DynamicResource ExclusionTooltip}" />
                  <Button Grid.Column="2" Content="{DynamicResource Add}" Click="AddStatisticsExclusion_Click" MinWidth="88" />
                </Grid>
                <ListBox x:Name="StatisticsExclusionList" ItemsSource="{Binding StatisticsExcludedExecutables}" Background="Transparent" BorderThickness="0" MinHeight="60" Margin="0,8,0,8" />
                <Button Content="{DynamicResource RemoveSelected}" Click="RemoveStatisticsExclusion_Click" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource WindowsBehavior}" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="{DynamicResource LaunchAtStartup}" IsChecked="{Binding LaunchAtStartup}" />
                <CheckBox Content="{DynamicResource StartMinimized}" IsChecked="{Binding StartMinimized}" />
                <CheckBox Content="{DynamicResource CloseMinimizeTray}" IsChecked="{Binding CloseToTray}" />
                <CheckBox Content="{DynamicResource PauseFullscreen}" IsChecked="{Binding PauseInFullscreen}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource PointerDeviceClassification}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource PointerDeviceClassificationHelp}" Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding PointerDevices}">
                  <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" /><ComboBox Grid.Column="2" ItemsSource="{Binding FamilyOptions}" SelectedIndex="{Binding FamilyIndex}" /><TextBlock Grid.Column="4" Text="{Binding ConnectionStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource PerAppMuting}" Style="{StaticResource SectionTitle}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="ExclusionPath" ToolTip="{DynamicResource ExclusionTooltip}" />
                  <Button Grid.Column="2" Content="{DynamicResource Add}" Click="AddExclusion_Click" MinWidth="88" />
                </Grid>
                <ListBox x:Name="ExclusionList" ItemsSource="{Binding ExcludedExecutables}" Background="Transparent" BorderThickness="0" MinHeight="60" Margin="0,8,0,8" />
                <Button Content="{DynamicResource RemoveSelected}" Click="RemoveExclusion_Click" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource ResetSettings}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource ResetSettingsHelp}" Style="{StaticResource MutedText}" /></StackPanel>
                <Button Grid.Column="2" Content="{DynamicResource ResetSettings}" Click="ResetSettings_Click" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{DynamicResource NavIntegrations}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource IntegrationsIntro}" Style="{StaticResource PageIntro}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox Content="{DynamicResource EnableActionResultApi}" IsChecked="{Binding IntegrationApiEnabled}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource ActionApiHelp}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource NamedPipe}" Style="{StaticResource SectionTitle}" />
