                        </Border>
                      </Grid>
                      <TextBlock Grid.Row="2" Text="{Binding Family}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,4,0,8" />
                      <TextBlock Grid.Row="3" Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                      <TextBlock Grid.Row="4" Text="{DynamicResource SelectToActivate}" Style="{StaticResource MutedText}" />
                    </Grid>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding DataContext.SoundPackGridView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                      <Setter TargetName="SoundPackListLayout" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="SoundPackGridLayout" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource AutomaticPackRotation}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource AutomaticPackRotationHelp}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
