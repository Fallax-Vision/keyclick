<Window x:Class="KeyClick.App.ScrollCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FunCalibrateScroll}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="{DynamicResource FunCalibrateScroll}" Style="{StaticResource PageTitle}" />
    <TextBlock Text="{DynamicResource FunCalibrationHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,16" />
    <TextBlock Text="{DynamicResource FunKnownDistance}" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="KnownDistance" Text="10" />
    <Border x:Name="ScrollSurface" Style="{StaticResource Card}" Height="150" Margin="0,14,0,0" Focusable="True" PreviewMouseWheel="ScrollSurface_PreviewMouseWheel">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="↕" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{DynamicResource FunScrollCalibrationSurface}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBlock x:Name="DetentCount" Text="0" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{DynamicResource Reset}" Click="Reset_Click" Style="{StaticResource DialogButton}" Margin="0,0,8,0" />
      <Button Content="{DynamicResource Cancel}" IsCancel="True" Style="{StaticResource DialogButton}" Margin="0,0,8,0" />
      <Button Content="{DynamicResource Apply}" Click="Apply_Click" Style="{StaticResource DialogAccentButton}" />
    </StackPanel>
  </StackPanel>
</Window>
