<Window x:Class="KeyClick.App.PrivacyDisclosureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StatisticsPrivacyTitle}" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/keyclick.ico">
  <StackPanel Margin="26">
    <TextBlock Text="{DynamicResource StatisticsPrivacyTitle}" Style="{StaticResource PageTitle}" />
    <TextBlock Text="{DynamicResource StatisticsPrivacyDisclosure}" Style="{StaticResource MutedText}"
               TextWrapping="Wrap" Margin="0,4,0,18" />
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <CheckBox x:Name="KeyboardToggle" Content="{DynamicResource KeyboardStatistics}" IsChecked="True" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource KeyboardStatisticsPrivacyHelp}" Style="{StaticResource MutedText}" Margin="22,2,0,12" TextWrapping="Wrap" />
        <CheckBox x:Name="PointerToggle" Content="{DynamicResource PointerStatistics}" IsChecked="True" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource PointerStatisticsPrivacyHelp}" Style="{StaticResource MutedText}" Margin="22,2,0,12" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource ApplicationStatisticsPrivacyHelp}" Style="{StaticResource MutedText}" Margin="22,0,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBlock Text="{DynamicResource StatisticsNeverNetwork}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,18" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{DynamicResource NotNow}" Click="NotNow_Click" Margin="0,0,10,0" Style="{StaticResource DialogButton}" />
      <Button Content="{DynamicResource ConfirmAndContinue}" Click="Continue_Click" Style="{StaticResource DialogAccentButton}" />
    </StackPanel>
  </StackPanel>
</Window>
